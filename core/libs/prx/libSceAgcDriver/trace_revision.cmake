set(commit unknown)
set(dirty -1)
set(describe unknown)
if(GIT)
    execute_process(COMMAND "${GIT}" -C "${SOURCE}" rev-parse --short=12 HEAD
            OUTPUT_VARIABLE head RESULT_VARIABLE failed OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(failed EQUAL 0 AND NOT head STREQUAL "")
        set(commit ${head})
        execute_process(COMMAND "${GIT}" -C "${SOURCE}" status --porcelain --untracked-files=no
                OUTPUT_VARIABLE changes RESULT_VARIABLE failed ERROR_QUIET)
        if(failed EQUAL 0 AND changes STREQUAL "")
            set(dirty 0)
        elseif(failed EQUAL 0)
            set(dirty 1)
        endif()
        # The [run-id] line: the describe, and for a dirty tree a hash of its diff, so two dirty
        # builds of the same commit tell apart.
        execute_process(COMMAND "${GIT}" -C "${SOURCE}" describe --always --dirty --abbrev=12
                OUTPUT_VARIABLE described RESULT_VARIABLE failed OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(failed EQUAL 0 AND NOT described STREQUAL "")
            set(describe ${described})
        endif()
        if(dirty EQUAL 1)
            execute_process(COMMAND "${GIT}" -C "${SOURCE}" diff HEAD
                    OUTPUT_VARIABLE diff RESULT_VARIABLE failed ERROR_QUIET)
            if(failed EQUAL 0)
                string(SHA1 diffHash "${diff}")
                string(SUBSTRING ${diffHash} 0 8 diffHash)
                set(describe "${describe}+${diffHash}")
            endif()
        endif()
    endif()
endif()
if(DESCRIBE_OUTPUT)
    file(WRITE "${DESCRIBE_OUTPUT}.new" "#pragma once\n#define APS5_TRACE_DESCRIBE \"${describe}\"\n")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${DESCRIBE_OUTPUT}.new" "${DESCRIBE_OUTPUT}")
    file(REMOVE "${DESCRIBE_OUTPUT}.new")
endif()
file(WRITE "${OUTPUT}.new" "#pragma once\n#define APS5_TRACE_COMMIT \"${commit}\"\n#define APS5_TRACE_DIRTY ${dirty}\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.new" "${OUTPUT}")
file(REMOVE "${OUTPUT}.new")
